    },
    "rewards": [{ "type": "xp", "amount": 550, "reason": "quest" }],
    "defaults": [
      { "id": "night_visits", "week": 1, "effects": [] },
      { "id": "milo_dies", "week": 2, "effects": [] },
      { "id": "cough_spreads", "week": 3, "effects": [] },
      { "id": "orphanage_ban", "week": 4, "effects": [] },
      { "id": "tess_song", "week": 5, "effects": [] },
      {
        "id": "accusation",
        "week": 6,
        "unless": "a1_oola_fate",
        "effects": [{ "type": "flag", "key": "a1_witch_trial_started", "value": true }]
      },
      { "id": "arrest", "week": 7, "unless": "a1_oola_fate", "effects": [] },
      {
        "id": "awaiting_transfer",
        "week": 9,
        "unless": "a1_oola_fate != convicted",
        "effects": []
      },
      { "id": "transfer_set", "week": 10, "unless": "a1_oola_fate != convicted", "effects": [] }
    ]
  },
