[
  {
    "id": "q_a1_d01_tax_and_bandits",
    "act": "act1",
    "kind": "dispute",
    "order": 20,
    "title": "税与匪",
    "desc": "代官莫斯以讨伐魔物为名加税，荒原的独眼团照样劫掠商队。没人插手，这件事也会自己走到头。",
    "trigger": "quest.q_a1_m03_register == done AND NOT dispute.q_a1_d01_tax_and_bandits.ending",
    "stages": [
      {
        "id": "unfold",
        "desc": "税单越贴越多，南路上的商队一支接一支出事。",
        "objectives": [
          {
            "type": "flag",
            "when": "dispute.q_a1_d01_tax_and_bandits.by == player AND (dispute.q_a1_d01_tax_and_bandits.ending IN (exposed, puppet, dead, arrested) OR a1_oneeye_fate IN (absorbed, destroyed))",
            "label": "插手这件事，让它换一个收场"
          }
        ]
      }
    ],
    "byOther": {
      "when": "dispute.q_a1_d01_tax_and_bandits.ending AND NOT (dispute.q_a1_d01_tax_and_bandits.by == player AND (dispute.q_a1_d01_tax_and_bandits.ending IN (exposed, puppet, dead, arrested) OR a1_oneeye_fate IN (absorbed, destroyed)))"
    },
    "rewards": [{ "type": "xp", "amount": 600, "reason": "quest" }],
    "defaults": [
      {
        "id": "standing",
        "week": 1,
        "effects": [
          {
            "type": "flag",
            "key": "a1_moss_fate",
            "value": "in_power",
            "when": "NOT a1_moss_fate"
          },
          {
            "type": "flag",
            "key": "a1_oneeye_fate",
            "value": "active",
            "when": "NOT a1_oneeye_fate"
          },
          { "type": "flag", "key": "a1_old_watch", "value": "bandits", "when": "NOT a1_old_watch" },
          {
            "type": "flag",
            "key": "a1_viro_status",
            "value": "in_band",
            "when": "NOT a1_viro_status"
          }
        ]
      },
      {
        "id": "tax_notice",
        "week": 1,
        "effects": [{ "type": "flag", "key": "a1_tax_rate", "value": "sixth" }]
      },
      { "id": "first_levy", "week": 2, "effects": [] },
      { "id": "owen_robbed", "week": 3, "effects": [] },
      { "id": "owen_petition", "week": 4, "effects": [] },
      { "id": "well_tax", "week": 5, "effects": [] },
      { "id": "tax_protest", "week": 7, "effects": [] },
      {
        "id": "owen_leaves",
        "week": 7,
        "unless": "a1_owen_escorted",
        "effects": [{ "type": "flag", "key": "a1_owen_left", "value": true }]
      }
    ]
  },
  {
