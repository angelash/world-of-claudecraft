    "maps": ["borderstone", "forest_edge"],
    "severity": "moderate",
    "when": "seal_unrest >= 91 OR act_week >= 10",
    "once": true,
    "effects": [{ "type": "flag", "key": "a1_tide_omen", "value": true }]
  },
