  {
    "id": "ev_a1_moira_coincidence",
    "category": "coincidence",
    "source": "director",
    "title": "命运的巧合",
    "narration": "一阵风从街角卷过来，把什么东西吹到了你的脚边。",
    "acts": [1],
    "maps": [],
    "severity": "minor",
    "when": "ev.ev_a1_moira_coincidence.count < 1 OR (goddess.moira.interest >= 2 AND ev.ev_a1_moira_coincidence.count < 2)",
    "director": { "move": "coincidence", "power": 2, "cooldownHours": 72 },
    "effects": [
      {
        "type": "line",
        "speaker": "narrator",
        "text": "一阵风把侯克摊开的档案吹得哗哗翻，停在了一页：东林之约。",
        "when": "NOT a1_forest_pact_proof AND NOT dispute.q_a1_d04_forest_dispute.ending"
      },
      {
        "type": "line",
        "speaker": "narrator",
        "text": "醉月亭的一个酒客碰巧说起二十年前那支探索队，说到一半就被人拉走了。",
        "when": "a1_forest_pact_proof AND (NOT npc.bron.story_level OR npc.bron.story_level < 2)"
      },
      {
        "type": "line",
        "speaker": "narrator",
        "text": "骰子屋的赌桌上，一枚骰子滚到你脚边。翻过来，底面沾着矿灰。",
        "when": "a1_forest_pact_proof AND npc.bron.story_level >= 2 AND NOT a1_viro_pact_known"
      },
      {
        "type": "line",
        "speaker": "narrator",
        "text": "夜羽从集市拿回来的亮东西里，有一枚代官府的火漆印残片。",
        "when": "a1_forest_pact_proof AND npc.bron.story_level >= 2 AND a1_viro_pact_known AND NOT a1_moss_exposed"
      }
    ]
  },
