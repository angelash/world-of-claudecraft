            "id": "unsure",
            "label": "我还不知道。",
            "to": "truth"
          }
        ]
      },
      {
        "id": "truth",
        "effects": [
          {
            "type": "flag",
            "key": "a5_truth_purge_cycle",
            "value": true
          },
          {
            "type": "item",
            "item": "evidence_e12"
          },
          {
            "type": "item",
            "item": "evidence_e09"
          },
          {
            "type": "item",
            "item": "evidence_e10"
          },
          {
            "type": "item",
            "item": "evidence_e11"
          },
          {
            "type": "item",
            "item": "evidence_e13"
          }
        ],
        "lines": [
          {
            "speaker": "narrator",
            "text": "那一天，所有战士都听见了同一道神谕。"
          },
          {
            "speaker": "valda",
            "text": "魔王就是澱。是我们排出去的东西。我和那个装模作样的，一起设计的。"
          },
          {
            "speaker": "valda",
            "text": "你吃肉的时候会给猪道歉吗？"
          },
          {
            "speaker": "ferryman",
            "text": "我作证。勇者打完魔王，就没用了。魔王倒下的时候，灰化成烟，飘向两座神殿。"
          }
        ]
      }
    ]
