      {
        "id": "corridor",
        "lines": [
          {
            "speaker": "narrator",
            "text": "她打开你的门，用你的能力对付你。你唯一能伤到她的办法，是关门：永远放弃门后的东西。"
          },
          {
            "speaker": "narrator",
            "text": "你关上了一扇，又一扇。"
          }
        ],
        "choices": [
          {
            "id": "close_all",
            "label": "（把门一扇一扇全部关上）",
            "to": "corridor_end",
            "effects": [
              {
                "type": "flag",
