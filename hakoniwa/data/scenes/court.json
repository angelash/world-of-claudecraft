          {
            "id": "let_go",
            "label": "你读对了。所以，你也得放手。……我也放手。我会归还千门。",
            "to": "janu_answer",
            "effects": [
              {
                "type": "flag",
                "key": "court.player_lets_go",
                "value": true
              }
            ]
