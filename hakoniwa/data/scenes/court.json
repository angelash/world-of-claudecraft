            "speaker": "janu",
            "text": "为了让门一直开着。"
          },
          {
            "speaker": "janu",
            "text": "开启复原之门吧。或者……把我的全部，拿去。"
          }
        ],
        "choices": [
          {
            "id": "restore",
            "label": "（开启复原之门）",
