        "choices": [
          {
            "id": "like",
            "label": "喜欢。",
            "to": "gift",
            "effects": [
              {
                "type": "flag",
                "key": "janu.first_dream_answer",
                "value": "like"
              }
            ]
          },
          {
            "id": "unsure",
            "label": "还不知道。",
            "to": "gift",
            "effects": [
              {
                "type": "flag",
                "key": "janu.first_dream_answer",
                "value": "unsure"
              }
            ]
          },
          {
            "id": "dislike",
