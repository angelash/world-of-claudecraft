{
  "id": "bark_gatefolk_hidden_daily",
  "slots": {
    "bark.crowd": [
      "（低声）门缝开着。",
      {
        "zh": "手套戴好。",
        "mood": ["fear"]
      },
      "敲三短一长。",
      {
        "zh": "又有人被带走了。",
        "mood": ["worried"]
      },
      "别抬头，走你的。",
      {
        "zh": "夜里留门。",
        "when": "hour >= 20 OR hour < 5"
      },
      {
        "zh": "巡夜的过来了。",
        "mood": ["fear"]
      },
      "母亲会回来的。",
      {
        "zh": "孩子平安到了。",
        "mood": ["happy"]
      },
      "别在神父面前出声。",
      {
        "zh": "手背在发烫……",
        "mood": ["fear"]
      },
      "今晚有人要过路。",
      {
        "zh": "下一站断了。",
        "mood": ["worried"]
      },
      "把灯压低。",
      {
        "zh": "今天没事，睡吧。",
        "mood": ["calm"]
      },
      {
        "zh": "那人看我的手了。",
        "mood": ["fear"]
      },
      "唱那首歌要小声。",
      {
        "zh": "有人留了面包在门口。",
        "mood": ["happy"]
      },
      {
        "zh": "门开着，路很长。",
        "when": "hour >= 20 OR hour < 5"
      },
      "别问名字。",
      {
        "zh": "老人走了，没人记得后半首歌了。",
        "mood": ["worried"]
