{
  "id": "ln_shiya",
  "speaker": "shiya",
  "slots": {
    "greet.cold.day": ["有事？", "（嗅了嗅）你身上有酒味。离远点。", "我在忙。说快点。"],
    "greet.cold.night": ["夜里别靠近东坡。", "回去吧。", "你跟着我干什么？"],
    "greet.neutral.day": ["你来了。", "林子今天安静。", "要进林子？跟紧我。"],
    "greet.neutral.night": ["还不睡？", "夜里林子里的东西多。", "月亮亮，好走路。"],
    "greet.warm.day": [
      "来了。说好了，今天一起进林子。",
      "祖灵在上，你又给我带了什么麻烦？",
      "我闻到你了，老远就闻到了。"
    ],
    "greet.warm.night": ["坐。火边暖和。", "你睡不着？我也是。", "今晚的风，好闻。"],
    "farewell": ["走吧。", "说好了的事，别忘。", "小心，林子边有狼。"],
    "unbelief.deny": [
      "传闻？我不听传闻。",
      "他们说的我没看见，不算。",
      "人族的嘴，十句有八句是吹的。"
    ],
    "unbelief.explain": ["我没看见，不说。", "等我亲眼看。", "也许是运气。也许不是。我要看。"],
    "unbelief.waver": [
      "我闻得出来。你不一样。",
      "（耳朵竖起来）那一下……是真的。",
      "我看见了，就信。"
    ],
    "topic.gen_you": {
      "act1": ["你闻起来像外面的风。不是这里的。", "我信你。我看见了。别让我后悔。"]
    },
    "topic.gen_self": {
      "cold": ["希雅。东坡的。", "猎户。就这样。"],
      "neutral": ["希雅。狼族。东坡的猎户。", "我家在东坡。人族叫那里狗坡。我们叫东坡。"],
      "warm": [
        "我叫希雅。会射箭，会追踪，会剥皮。不会说好听的话。",
        "我想让家里人别再被叫\"狗坡的\"。就这个。"
      ]
    },
    "topic.gen_work": {
      "K0": ["打猎。天亮进林子，午后剥皮，集日卖皮子。", "皮子总被压价。我知道，可是要吃饭。"]
    },
    "topic.gen_past": {
      "cold": ["不想说。", "（她转开了视线）"],
      "warm": ["我们是从草原那边过来的。很久以前。", "我爹……不说了。"]
    },
    "topic.gen_advice": {
      "K0": ["进林子先看风。逆风走，它们闻不到你。", "狼不会无缘无故咬人。会咬人的狼，都是被逼的。"]
    },
    "topic.gen_faith": {
      "K0": ["祖灵在上。还有林子的母亲。", "礼拜堂？我不进去。他们看我的耳朵。"]
    },
    "topic.self_shiya_family": {
      "K0": ["我有个弟弟，阿柯。他总闯祸。", "东坡的人都是一家人。谁欺负一个，就是欺负全部。"]
    },
    "topic.self_shiya_nose": {
      "K0": ["我闻得出来。人撒谎的时候，味道会变。", "林子病了，也有味道。最近有。"]
    },
    "topic.secret_shiya_reading": {
      "K0": [
        {
          "zh": "……我在跟伊莎修女学认字。别笑。",
          "when": "trust.shiya >= 60"
        },
        {
          "zh": "我想自己看林约上写的是什么，不用别人念给我听。",
          "when": "trust.shiya >= 60"
        }
      ]
    },
    "topic.place_east_forest": {
      "K0": ["林缘那边是我们的猎径。越往里，树越老。", "约树在林子深处。上面刻着林约。"],
      "K1": ["伐区越往北推，林子里的东西越凶。不是我们引的。"]
    },
    "topic.danger_east_forest": {
      "K0": ["北边有狼，颜色不对。灰的。我早说了，没人信。", "别一个人往伐区北边走。"]
    },
    "topic.lore_wolf_saying": {
      "K1": [
        {
          "zh": "族里的老话：很久以前，草原和海之间只隔一扇门。",
          "when": "trust.shiya >= 40"
        },
        {
          "zh": "老人们这么说。我也不知道是什么意思。",
          "when": "trust.shiya >= 40"
        }
      ]
    },
    "topic.person_gaspar": {
      "K0": [
        "加斯帕？他恨我们。他弟弟的事，不是我们干的。",
        {
          "zh": "……加斯帕也不全是坏人。他护他的工人。",
          "when": "a1_forest_accord == restored"
        }
      ]
    },
    "topic.person_ako": {
      "K0": ["阿柯没偷东西。我闻得出来。"]
    },
    "topic.place_bs_east_slope": {
      "K0": ["东坡。我们的家。皮架、熏肉棚，还有狗……不对，没有狗。", "别在东坡说\"狗坡\"。"]
    },
    "react.feat_seen": ["（耳朵竖起来）……好。", "我看见了。是真的。"],
