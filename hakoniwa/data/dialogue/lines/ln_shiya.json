  "acts": {
    "act1": {
      "greet.neutral": [
        {
          "zh": "你闻起来不像这里的人。",
          "first": true
        },
        {
          "zh": "人族？来东坡做什么。",
          "when": "act_week <= 4"
        },
        {
          "zh": "……别跟我说话。现在不想。",
          "when": "a1_forest_accord == broken"
        }
      ],
      "greet.warm": [
        {
          "zh": "那一夜，你守住了。我看见了。",
          "when": "a1_beast_tide_cleared"
        },
        {
          "zh": "裂耳的牙，你留着。那是你的。",
          "when": "quest.q_a1_m05_grey_wolf"
        }
