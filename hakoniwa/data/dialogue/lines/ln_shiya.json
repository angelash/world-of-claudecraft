    "bark.hurt": ["呜……没事。", "擦破皮。", "还能拉弓。"],
    "bark.victory": ["倒了。", "好。收箭。", "剥皮的活归我。"],
    "bark.ally_down": ["起来！别躺着！", "我来拖你！", "喂！看着我！"],
