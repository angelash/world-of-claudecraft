    "react.quote": [
      "\"一座城的名字，往往比城活得久。\"",
      "\"记下来的事，就不只属于记下它的人了。\"",
      "\"最安静的一页，常常是被撕掉的那一页。\"",
      "\"故事从不在开头讲清楚为什么开始。\"",
      "\"门槛上的灰，比门里的人更记得来过谁。\"",
      "\"誓言写在纸上，债写在心里。\"",
      "\"一个没有名字的人，也会留下脚印。\"",
      "\"伏笔不是谎言，只是还没到它该说话的那一页。\""
    ],
    "react.oracle_instruct": [
