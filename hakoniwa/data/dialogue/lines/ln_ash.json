{
  "id": "ln_ash",
  "speaker": "ash",
  "slots": {
    "greet.cold.day": ["……又来了。", "灰里不分昼夜。说吧。", "你身上带着血的味道。"],
    "greet.cold.night": ["……", "墙上的字还没写完。别打扰。", "退后一步，门的孩子。"],
    "greet.neutral.day": ["门的孩子。", "你来了。墨还没干。", "坐吧，灰是软的。"],
    "greet.neutral.night": ["夜里的灰更冷。你不该来。", "……嗯。", "门的孩子，你又走下来了。"],
    "greet.warm.day": [
      {
        "zh": "你来了。这一行，可以接着写了。",
        "when": "act >= 3"
      },
      {
        "zh": "门的孩子。坐近一点。",
        "when": "act >= 3"
      },
      {
        "zh": "我等你很久了。……不，是我等的那件事很久了。",
        "when": "act >= 3"
      }
    ],
    "greet.warm.night": [
      {
        "zh": "灰今晚很安静。",
        "when": "act >= 3"
      },
      {
        "zh": "你带着她的味道，又来了。",
        "when": "a3_ash_tells_sundering"
      },
      {
        "zh": "坐吧。我念一段给你听。",
        "when": "act >= 3"
      }
    ],
    "farewell": ["去吧，门的孩子。", "还不是时候。", "墨会干，字不会。"],
    "topic.gen_you": {
      "act1": ["还不是时候。"],
      "doubt": [
        {
          "zh": "你还不知道自己是什么。这不是你的错。",
          "when": "act >= 2"
        },
        {
          "zh": "你推开的每一扇门，都写在墙上。",
          "when": "act >= 2"
        }
      ],
      "explaining": [
        {
          "zh": "你身上有一扇门。这一行我认得。",
          "when": "act >= 2"
        },
        {
          "zh": "门不会选错人。人会选错门。",
          "when": "act >= 2"
        }
      ],
      "wavering": [
        {
          "zh": "你开的门越多，我越不知道该怎么写你。",
          "when": "act >= 3"
        },
        {
          "zh": "也许你是对的人。也许不是。我还在读。",
          "when": "act >= 3"
        }
      ],
      "worship": [
        {
          "zh": "我不崇拜任何人。我只等。",
          "when": "act >= 3"
        },
        {
          "zh": "门的孩子……你让我想起很多年前的一句话。",
          "when": "act >= 3"
        }
      ],
      "hostile": [
        {
          "zh": "你要强行打开这扇门吗？那你就是我的敌人。",
          "when": "act >= 3"
        },
        {
          "zh": "停下。这一行，不能这样写。",
          "when": "act >= 3"
        }
      ]
    },
    "topic.gen_self": {
      "cold": ["一个守门的人。", "……还不是时候。"],
      "neutral": [
        {
          "zh": "他们叫我阿什。灰烬之阿什。我记得每一卷书的名字，却忘了自己的。",
          "when": "act >= 2"
        },
        {
          "zh": "我在这里守着一扇门。很久了。",
          "when": "act >= 2"
        }
      ]
    },
    "topic.gen_work": {
      "K3": [
        {
          "zh": "守门。抄写。墙上这些字，是我凭记忆重写的。",
          "when": "act >= 2"
        },
        {
          "zh": "抄写员的手，不会忘记一个字。",
          "when": "act >= 2"
        }
      ]
    },
    "topic.self_ash_writing": {
      "K3": [
        {
          "zh": "墙上的字？这一行还没写完。",
          "when": "act >= 2"
        },
        {
          "zh": "那是一座城的记录。一座有很多门的城。你现在可以读了。",
          "when": "a3_ash_tells_sundering"
        }
      ]
    },
    "topic.self_ash_name": {
      "K3": [
        {
          "zh": "我记得每一卷书的名字，却忘了自己的。",
          "when": "act >= 2"
        },
        {
          "zh": "阿什。灰。这个名字够用了。",
          "when": "act >= 2"
        }
      ]
    },
    "topic.place_sealed_ruins": {
      "K3": [
        {
          "zh": "这里是封门。封住的门。别问门后面是什么。",
          "when": "act >= 2"
        },
        {
          "zh": "上面那层画着六个纹。下面这层，只有灰。",
          "when": "act >= 2"
        }
      ]
    },
    "topic.lore_dian_word": {
      "K3": [
        {
          "zh": "澱。灰里的东西，会咬人，会长。你身上也沾了一点。",
          "when": "act >= 2"
        },
        {
          "zh": "澱会长。在没人看着的地方长得最快。",
          "when": "act >= 2"
        }
      ]
    },
    "topic.lore_door_mural": {
      "K3": [
        {
          "zh": "门连着门。这是画，不是梦。",
          "when": "act >= 2"
        },
        {
          "zh": "那幅画上的城，我在里面抄过书。",
          "when": "a3_ash_tells_sundering"
        }
      ]
    },
    "topic.lore_sixth_sigil": {
      "K3": [
        {
          "zh": "第六个纹，属于她。名字是她剩下的最后一样东西。",
          "when": "a3_ash_tells_sundering"
        },
        {
          "zh": "我不说她的名字。你也别问。",
          "when": "a3_ash_tells_sundering"
        }
      ]
    },
    "react.evade": ["还不是时候。", "这一行，还没写到。"],
    "react.hint": [
      {
        "zh": "门开的时候，记得回头看一眼。",
        "when": "act >= 2"
      },
      {
        "zh": "墨会干，字不会。你写下的，会一直在。",
        "when": "act >= 2"
      }
    ],
    "react.deny": ["不是这样。", "你读错了。"],
    "react.feat_seen": ["嗯。门的孩子，你学得很快。", "这一笔，我记下了。"],
    "react.gift_liked": [
      {
        "zh": "纸？……很多年没人给我带纸了。",
        "when": "act >= 2"
      },
      {
        "zh": "一本书。谢谢。我会读完它。",
        "when": "act >= 2"
      }
    ],
    "react.gift_disliked": [
      {
        "zh": "我不需要这个。",
        "when": "act >= 2"
      },
      {
        "zh": "留给活着的人吧。",
        "when": "act >= 2"
      }
    ],
    "react.insult": ["骂吧。灰不会生气。", "你的话会被风吹走。我的字不会。"],
    "react.thanked": ["不必。", "记下来就够了。"],
    "react.flattered": ["我只是个抄写员。", "这一句，不必写进墙里。"],
    "react.threatened": ["你可以试试。灰会把你送回去。", "门的孩子，别做蠢事。"],
    "react.helped": [
      {
        "zh": "你帮了守门的人。这一行，我会写上。",
        "when": "act >= 2"
      },
      {
        "zh": "谢谢你，门的孩子。",
        "when": "act >= 2"
      }
    ],
    "react.saved": [
      {
        "zh": "……你接住了这一扇门。",
        "when": "act >= 5"
      },
      {
        "zh": "我以为这一行会断在这里。",
        "when": "act >= 5"
      }
    ],
    "react.identity_claim": [
      "你从哪里来，不重要。你推开了门，这才重要。",
      {
        "zh": "我的故乡也有过很多神。后来，它们都不说话了。",
        "when": "a3_ash_tells_sundering"
      }
    ],
    "react.accused": ["我不说谎。我只省略。", "你会读懂的。不是现在。"],
    "react.confused": ["慢一点。灰里的时间很多。", "再说一遍。"],
    "react.nonsense": ["这个词，我没抄过。", "……你累了。"],
    "bark.work": ["这一行还没写完……", "墨会干，字不会。", "……（他在写字）"],
    "bark.night": [
      "灰在落。很安静。",
      {
        "zh": "……她们还在吵吗。",
        "when": "act >= 2"
      }
    ],
    "bark.see_player": ["门的孩子来了。", "嗯。"]
  },
  "acts": {
    "act1": {
      "greet.neutral": ["还不是时候。去吧，门的孩子。", "……（他没有回头）", "还不是时候。"],
      "greet.cold": ["还不是时候。"],
      "farewell": ["去吧，门的孩子。"],
      "react.threatened": [
        {
          "zh": "……还不是时候。",
          "when": "a1_ash_met"
        }
      ]
    }
  }
}
