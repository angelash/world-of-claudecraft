  "acts": {
    "act1": {
      "greet.neutral": [
        {
          "zh": "你身上有门的味道。说不出是谁的门。",
          "when": "a1_yeyu_bound",
          "first": true
        },
        {
          "zh": "契约就是契约。我跟着你，不代表我喜欢你。",
          "when": "a1_yeyu_bound AND act_week <= 3"
        },
        "我是乌鸦。别问第二遍。"
      ],
      "greet.warm": [
        {
          "zh": "那一夜……你没跑。还行。",
          "when": "a1_beast_tide_cleared"
        },
        {
          "zh": "你手上那个……没什么。手洗干净再说话。",
          "when": "a1_dream_door_woman"
        }
