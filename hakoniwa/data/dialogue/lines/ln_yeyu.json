    "topic.self_yeyu_door": {
      "K0": [
        {
          "zh": "那扇门，是不该被打开的。可我等了好久好久。",
          "when": "a1_yeyu_bound AND act_week >= 8"
        },
        {
          "zh": "……我不知道。我只记得我在等。",
          "when": "a1_yeyu_bound AND act_week >= 8"
        }
      ]
    },
