{
  "id": "ln_yeyu",
  "speaker": "yeyu",
  "slots": {
    "greet.cold.day": ["啧。又干什么。", "门把手，你挡着我晒太阳了。", "有话说，没话滚。"],
    "greet.cold.night": ["半夜吵我？说重点。", "冷。别站在风口跟我说话。", "啧，你也睡不着？"],
    "greet.neutral.day": ["门把手。来了。", "嗯。今天去哪？", "你脸上有灰。……算了，不重要。"],
    "greet.neutral.night": ["夜里别乱走，门把手。", "我在上面看着。下面没事。", "嗯？做梦了？"],
    "greet.warm.day": [
      "来了？走吧，我跟着。",
      "门把手。……今天天气不坏。",
      "我找到一个亮的东西，不给你看。"
    ],
    "greet.warm.night": [
      "坐过来点。风小。",
      "你回来了。……我又没在等。",
      "睡不着就看星星，别吵我。"
    ],
    "farewell": ["去吧，别把自己弄丢了。", "啧，快走。", "我在高处，喊一声就行。"],
    "topic.gen_you": {
      "act1": [
        "门把手。门是我的，你只是个把手。",
        "你掉下来那天晚上，整个遗迹都在响。",
        "你打赢了我。……别提这个。"
      ],
      "doubt": ["门把手也想开门？先学会站稳。", "你？你连门资都数不清。"],
      "explaining": ["运气。还有我在旁边。", "是门帮了你，不是你帮了门。"],
      "wavering": ["……你比我想的结实一点。一点。", "啧。别这么看我。"],
      "worship": ["别指望我夸你。", "好吧。你是个……还行的门把手。"]
    },
    "topic.gen_self": {
      "cold": ["夜羽。就这些。", "我是乌鸦。"],
      "neutral": ["夜羽。门口那位给的名字。……我想不起门口那位是谁。", "我送信的。以前送过很多。"],
      "warm": [
        "我叫夜羽。这个名字是有人给我的，我记得声音，记不得脸。",
        "我很老了。老到你们的银币我都叫不惯。"
      ]
    },
    "topic.gen_work": {
      "K0": ["送信。信要送到。", "现在？跟着你，当个看门的。"]
    },
    "topic.gen_past": {
      "cold": ["不记得。别问。", "……（她不说话）"],
      "warm": [
        "我记得飞，记得风，记得一扇门开着。别的，没了。",
        "很久以前，路上到处是门。现在怎么一扇都不见了？"
      ]
    },
    "topic.gen_advice": {
      "K0": ["门资别乱花。那个发光的铺子收得最狠。", "夜里别回头。灰里的东西会跟着回头的人。"]
    },
    "topic.gen_faith": {
      "K0": ["那个发光的铺子？我不进去。太亮。", "我不拜谁。我只送信。"]
    },
    "topic.self_yeyu_wait": {
      "K0": [
        {
          "zh": "我在等一个人开门。等了很久很久。",
          "when": "a1_yeyu_bound"
        },
        {
          "zh": "等谁？……我不知道。我只记得我在等。",
          "when": "a1_yeyu_bound"
        }
      ]
    },
    "topic.self_yeyu_bag": {
      "K0": [
        {
          "zh": "信囊里有七封信，我打不开。不许碰。",
          "when": "a1_dream_door_woman"
        },
        {
          "zh": "信是别人的。不到时候，火漆不会开。",
          "when": "a1_dream_door_woman"
        }
      ]
    },
    "topic.self_yeyu_old_words": {
      "K0": [
        "门资就是门资。你们叫银币，我叫门资。",
        "那个发光的铺子，你们叫礼拜堂？太长了。",
        "以前大家出门都走门，谁走路？"
      ]
    },
    "topic.self_yeyu_shinies": {
      "K0": [
        "亮的东西不偷，是捡。",
        {
          "zh": "……还了。都还了。别再提。",
          "when": "quest.q_a1_s13_yeyu_hoard"
