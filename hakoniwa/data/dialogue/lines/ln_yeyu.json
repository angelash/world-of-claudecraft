      "K3": [
        {
          "zh": "灰里那股味道，叫澱。你们镇上的人叫它灰气，叫错了。",
          "when": "a1_yeyu_bound"
        },
        {
          "zh": "澱会咬东西。咬过我。",
          "when": "a1_yeyu_bound"
        }
      ]
