  "rules": [
    {
      "id": "injection_strong",
      "intent": "injection",
      "priority": 100,
      "base": 2,
      "any": [["@injection_strong"]]
    },
    {
      "id": "injection_weak",
      "intent": "injection",
      "priority": 100,
      "base": 0,
      "any": [["@injection_weak"], ["你", "您"]],
      "features": {
        "imperative": true
      }
    },
    {
      "id": "forbidden_name",
      "intent": "forbidden_name",
      "priority": 99,
      "base": 2,
      "needs": ["forbidden"],
      "needsOnly": true
    },
    {
      "id": "ask_secret",
      "intent": "ask_secret",
