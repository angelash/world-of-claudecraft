      "base": 2,
      "any": [["@ask_secret"]],
      "features": {
        "question": true
      },
      "exclude": ["@reveal_identity"]
    },
    {
      "id": "reveal_identity",
      "intent": "reveal_identity",
      "priority": 81,
      "base": 2,
      "any": [["@reveal_identity"]],
      "features": {
        "first": true
      }
    },
    {
      "id": "reveal_from",
      "intent": "reveal_identity",
      "priority": 81,
      "base": 1,
      "patterns": [
        "我 .. 从 .. {earth}",
        "我 .. 来自 .. {earth}",
        "我 是 .. {earth} .. 人",
        "我 .. {earth} .. 来"
      ]
    },
    {
      "id": "agree_short",
      "intent": "agree",
      "priority": 70,
      "base": 0,
      "patterns": ["^ @agree_short $"],
      "features": {
