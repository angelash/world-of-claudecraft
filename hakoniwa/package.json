{
  "name": "hakoniwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hakoniwa Chronicle: an HD-2D isekai game with LLM goddess game masters (prototype).",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "service:run": "node --import tsx tools/service/run.ts",
    "service:status": "node --import tsx tools/service/control.ts status",
    "service:restart": "node --import tsx tools/service/control.ts restart",
    "service:resume": "node --import tsx tools/service/control.ts resume",
    "build": "vite build --config vite.config.ts",
    "build:release": "vite build --config vite.config.ts --mode desktop",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p desktop/tsconfig.json",
    "build:desktop": "node desktop/build.ts",
    "desktop:dev": "npm run build && npm run build:desktop && node desktop/launch.ts",
    "pack:win": "npm run build:release && npm run build:desktop && node desktop/pack.ts",
    "playthrough": "vitest run --config vitest.playthrough.config.ts",
    "format": "node ../node_modules/@biomejs/biome/bin/biome check --write",
    "refs": "node tools/refs/fetch_refs.ts",
    "prompts": "node tools/prompts/build.ts",
    "prompts:check": "node tools/prompts/build.ts --check",
    "registry": "node tools/registry/build.ts",
    "registry:check": "node tools/registry/build.ts --check",
    "assets:register": "node ../node_modules/tsx/dist/cli.mjs tools/assets/register.ts",
    "assets:import": "node ../node_modules/tsx/dist/cli.mjs tools/assets/import.ts",
    "assets:atlas": "node ../node_modules/tsx/dist/cli.mjs tools/assets/atlas.ts",
    "assets:check": "node ../node_modules/tsx/dist/cli.mjs tools/assets/check.ts",
    "gate": "node tools/gate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "three": "^0.165.0"
  }
}
