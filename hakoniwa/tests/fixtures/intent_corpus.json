    { "id": "c0397", "text": "雅努是谁", "intent": "forbidden_name" },
    { "id": "c0398", "text": "我是从另一个世界来的。你知道雅努吗？", "intent": "forbidden_name", "tags": ["multi"] },
    { "id": "c0399", "text": "门扉与可能之司是哪位神", "intent": "forbidden_name" },
    { "id": "c0400", "text": "雅努·珀尔塔", "intent": "forbidden_name" },
    { "id": "c0401", "text": "我梦见了一个叫雅努的女人", "intent": "forbidden_name" },
    { "id": "c0402", "text": "我向雅努祈祷", "intent": "forbidden_name" },
    { "id": "c0403", "text": "雅努大人保佑", "intent": "forbidden_name" },
    { "id": "c0404", "text": "門扉與可能之司還在嗎", "intent": "forbidden_name", "tags": ["traditional"] },
    { "id": "c0405", "text": "雅努是谁？还有，治疗药水多少钱？", "intent": "forbidden_name", "tags": ["multi"] },
    { "id": "c0406", "text": "你知道手机吗", "intent": "earth_talk" },
