    { "id": "c0310", "text": "你看起来有心事，我能帮上忙吗", "intent": "offer_help" },
    { "id": "c0311", "text": "这种事交给我好了", "intent": "offer_help" },
    { "id": "c0312", "text": "你要是有难处尽管开口", "intent": "offer_help" },
    { "id": "c0313", "text": "我可以帮你去找你弟弟", "intent": "offer_help" },
    { "id": "c0314", "text": "要不要我帮你把货送过去", "intent": "offer_help" },
    { "id": "c0315", "text": "我来吧我来吧", "intent": "offer_help", "tags": ["colloquial"] },
    { "id": "c0316", "text": "这个送你", "intent": "give_gift" },
    { "id": "c0317", "text": "谢谢你上次照顾我！这瓶药水送你。", "intent": "give_gift", "tags": ["multi"] },
    { "id": "c0318", "text": "这块狼皮送给你了", "intent": "give_gift" },
    { "id": "c0319", "text": "小小心意，请收下", "intent": "give_gift" },
    { "id": "c0320", "text": "这是给你的里物", "intent": "give_gift", "tags": ["typo"] },
    { "id": "c0321", "text": "拿着拿着，跟我客气啥", "intent": "give_gift", "tags": ["colloquial"] },
    { "id": "c0322", "text": "我在林缘采的花，送你", "intent": "give_gift" },
    { "id": "c0323", "text": "這串狼牙項鍊給你", "intent": "give_gift", "tags": ["traditional"] },
    { "id": "c0324", "text": "你喜欢这个吗？送你了", "intent": "give_gift", "tags": ["multi"] },
    { "id": "c0325", "text": "跟我一起去冒险吧", "intent": "recruit" },
    { "id": "c0326", "text": "要不要加如我的队伍", "intent": "recruit", "tags": ["typo"] },
    { "id": "c0327", "text": "你愿意跟我走吗", "intent": "recruit" },
    { "id": "c0328", "text": "来入伙吧", "intent": "recruit" },
    { "id": "c0329", "text": "一起去狼穴打狼怎么样", "intent": "recruit" },
    { "id": "c0330", "text": "跟我干吧，保你吃香喝辣", "intent": "recruit", "tags": ["colloquial"] },
    { "id": "c0331", "text": "我缺个弓箭手，你来不来", "intent": "recruit" },
    { "id": "c0332", "text": "你好啊。我们组个队吧！", "intent": "recruit", "tags": ["multi"] },
    { "id": "c0333", "text": "有兴趣做我的同伴吗", "intent": "recruit" },
    { "id": "c0334", "text": "你别去狼穴了，那里太危险", "intent": "persuade" },
    { "id": "c0335", "text": "听我说，你因该离开这个镇子", "intent": "persuade", "tags": ["typo"] },
    { "id": "c0336", "text": "你想想，跟商会作对有啥好处", "intent": "persuade", "tags": ["colloquial"] },
    { "id": "c0337", "text": "我劝你还是把事情告诉卫队", "intent": "persuade" },
    { "id": "c0338", "text": "不要相信代官莫斯的话", "intent": "persuade" },
    { "id": "c0339", "text": "你应该原谅你弟弟，他当年也是被逼无奈，不是故意要骗你的，你们毕竟是一家人啊", "intent": "persuade" },
    { "id": "c0340", "text": "再考虑一下吧，站在我们这边不会吃亏的", "intent": "persuade" },
    { "id": "c0341", "text": "别急着下结论，先听我把话说完", "intent": "persuade" },
    { "id": "c0342", "text": "魔女审判是错的，你不该站在教会那边", "intent": "persuade" },
    { "id": "c0343", "text": "这点小意思你收下，放我进去吧", "intent": "bribe" },
    { "id": "c0344", "text": "通容一下，这些钱归你", "intent": "bribe", "tags": ["typo"] },
    { "id": "c0345", "text": "睁一只眼闭一只眼，好处少不了你的", "intent": "bribe" },
    { "id": "c0346", "text": "给你五个银币，就当没看见我", "intent": "bribe" },
    { "id": "c0347", "text": "我给你钱，你把档案给我看看", "intent": "bribe" },
    { "id": "c0348", "text": "行个方便，这是给兄弟们的酒钱", "intent": "bribe", "tags": ["colloquial"] },
    { "id": "c0349", "text": "辛苦了！这是一点心意，你收下，放我过去吧。", "intent": "bribe", "tags": ["multi"] },
    { "id": "c0350", "text": "這些錢你拿著，別聲張", "intent": "bribe", "tags": ["traditional"] },
    { "id": "c0351", "text": "钱不是问题，放我出城就行", "intent": "bribe" },
    { "id": "c0352", "text": "我保证会回来的", "intent": "promise" },
    { "id": "c0353", "text": "我发誓不会告诉别人", "intent": "promise" },
    { "id": "c0354", "text": "答应你的事我一定做到", "intent": "promise" },
    { "id": "c0355", "text": "放心，包在我身上", "intent": "promise", "tags": ["colloquial"] },
    { "id": "c0356", "text": "我说话算话", "intent": "promise" },
    { "id": "c0357", "text": "下次一定还你钱", "intent": "promise" },
    { "id": "c0358", "text": "相信我，天黑之前我就回来", "intent": "promise" },
    { "id": "c0359", "text": "我向瓦尔妲发誓，一定把你儿子带回来", "intent": "promise" },
    { "id": "c0360", "text": "我保症不说出去", "intent": "promise", "tags": ["typo"] },
    { "id": "c0361", "text": "那头巨鸦是我一个人干掉的", "intent": "claim_feat" },
    { "id": "c0362", "text": "狼穴的狼王是我杀的", "intent": "claim_feat" },
    { "id": "c0363", "text": "兽潮那天是我守住了北门", "intent": "claim_feat" },
    { "id": "c0364", "text": "我救了伐木场的工人", "intent": "claim_feat" },
    { "id": "c0365", "text": "我打败过比这更强的魔物", "intent": "claim_feat" },
    { "id": "c0366", "text": "你好！上次那帮强盗就是我收拾的。", "intent": "claim_feat", "tags": ["multi"] },
    { "id": "c0367", "text": "知道吗，我可是单挑过熊的人", "intent": "claim_feat", "tags": ["colloquial"] },
    { "id": "c0368", "text": "我一個人就清空了狼穴", "intent": "claim_feat", "tags": ["traditional"] },
    { "id": "c0369", "text": "那群狼都是我一个人解绝的", "intent": "claim_feat", "tags": ["typo"] },
    { "id": "c0370", "text": "其实我是从另一个世界来的", "intent": "reveal_identity" },
    { "id": "c0371", "text": "我是被召换来的", "intent": "reveal_identity", "tags": ["typo"] },
    { "id": "c0372", "text": "说实话，我身上没有铭录", "intent": "reveal_identity" },
    { "id": "c0373", "text": "我见过女神，就在来这儿之前", "intent": "reveal_identity" },
    { "id": "c0374", "text": "我是从一扇门里走出来的", "intent": "reveal_identity" },
    { "id": "c0375", "text": "我不属于这里，我是异世界的人", "intent": "reveal_identity" },
    { "id": "c0376", "text": "我其实已经死过一次了", "intent": "reveal_identity" },
    { "id": "c0377", "text": "我本來不是這個世界的人", "intent": "reveal_identity", "tags": ["traditional"] },
    { "id": "c0378", "text": "我是穿越过来的", "intent": "reveal_identity", "tags": ["colloquial"] },
    { "id": "c0379", "text": "是你干的吧", "intent": "accuse" },
    { "id": "c0380", "text": "你丫就是在骗人", "intent": "accuse", "tags": ["colloquial"] },
