    { "id": "c0287", "text": "任务搞定，来领赏", "intent": "quest_report", "tags": ["colloquial"] },
    { "id": "c0288", "text": "狼牙我以经带来了", "intent": "quest_report", "tags": ["typo"] },
    { "id": "c0289", "text": "能帮我修一下剑吗", "intent": "request_service" },
    { "id": "c0290", "text": "给我打一把长剑", "intent": "request_service" },
    { "id": "c0291", "text": "我受伤了，能帮我治一下吗", "intent": "request_service" },
    { "id": "c0292", "text": "教我射剑吧", "intent": "request_service", "tags": ["typo"] },
    { "id": "c0293", "text": "教两招防身的呗", "intent": "request_service", "tags": ["colloquial"] },
    { "id": "c0294", "text": "辛苦了。另外，能帮我看看这伤口吗？", "intent": "request_service", "tags": ["multi"] },
    { "id": "c0295", "text": "能给我做一副皮甲吗", "intent": "request_service" },
    { "id": "c0296", "text": "这把猎弓的弦断了，能换吗", "intent": "request_service" },
    { "id": "c0297", "text": "这皮甲能不能补一补，pls", "intent": "request_service", "tags": ["english"] },
    { "id": "c0298", "text": "帮帮我！", "intent": "ask_help" },
    { "id": "c0299", "text": "救命啊", "intent": "ask_help", "tags": ["colloquial"] },
    { "id": "c0300", "text": "不好意思打扰了。求你帮我这一次。", "intent": "ask_help", "tags": ["multi"] },
    { "id": "c0301", "text": "我刚到镇上，钱袋就在盐巷集市被人摸走了，你能帮帮我吗", "intent": "ask_help" },
    { "id": "c0302", "text": "能借我点钱吗", "intent": "ask_help" },
    { "id": "c0303", "text": "卫兵在追我，帮我藏一下", "intent": "ask_help" },
    { "id": "c0304", "text": "能不能帮我作个证", "intent": "ask_help" },
    { "id": "c0305", "text": "我迷路了…能带我一段吗", "intent": "ask_help" },
    { "id": "c0306", "text": "能不能帮帮我门", "intent": "ask_help", "tags": ["typo"] },
    { "id": "c0307", "text": "需要帮忙吗", "intent": "offer_help" },
    { "id": "c0308", "text": "我来帮你般吧", "intent": "offer_help", "tags": ["typo"] },
