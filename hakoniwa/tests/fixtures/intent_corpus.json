    { "id": "c0269", "text": "隔壁才卖一半价", "intent": "haggle" },
    { "id": "c0270", "text": "有活干吗", "intent": "ask_work" },
    { "id": "c0271", "text": "有什么委托可以接吗", "intent": "ask_work" },
    { "id": "c0272", "text": "我想赚点钱，有什么门路", "intent": "ask_work" },
    { "id": "c0273", "text": "你这里缺人手吗", "intent": "ask_work" },
    { "id": "c0274", "text": "早上好！有没有任务给我？", "intent": "ask_work", "tags": ["multi"] },
    { "id": "c0275", "text": "公会最近有什么悬赏", "intent": "ask_work" },
