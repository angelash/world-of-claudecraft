    { "id": "c0277", "text": "有沒有什麼差事可以做", "intent": "ask_work", "tags": ["traditional"] },
    { "id": "c0278", "text": "有什么委拖吗", "intent": "ask_work", "tags": ["typo"] },
    { "id": "c0279", "text": "狼穴的狼我都杀了", "intent": "quest_report" },
    { "id": "c0280", "text": "你要的狼皮我带来了", "intent": "quest_report" },
