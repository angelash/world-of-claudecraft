{
  "name": "anthropic_json_schema",
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "read": "json",
  "headers": {
    "content-type": "application/json",
    "anthropic-version": "2026-10-21",
    "anthropic-beta": "server-side-fallback-2026-07-01"
  },
  "body": {
    "model": "claude-opus-5-5",
    "max_tokens": 1000,
    "system": [
      {
        "type": "text",
        "text": "规则段：只按菜单行动。",
        "cache_control": {
          "type": "ephemeral",
          "ttl": "1h"
        }
      },
      {
        "type": "text",
        "text": "人设段：你是旅店老板。",
        "cache_control": {
          "type": "ephemeral",
          "ttl": "1h"
        }
      },
      {
        "type": "text",
        "text": "私密段：你记得昨天的客人。",
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "上一轮：客人进门。"
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "thinking",
            "thinking": "",
            "signature": "c2lnbmF0dXJlLWZpeHR1cmU="
          },
          {
            "type": "text",
            "text": "{\"commands\":[],\"speech\":\"欢迎。\"}"
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "玩家原话：有空房吗？"
          },
          {
            "type": "text",
            "text": "本轮：回答客人。"
          }
        ]
      },
      {
        "role": "system",
        "content": "内核通知：天色已晚。"
      }
    ],
    "output_config": {
      "effort": "high",
      "format": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "properties": {
            "commands": {
              "type": "array",
              "description": "本次提出的命令",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["npc.say", "npc.move"],
                    "description": "命令种类"
                  },
                  "data": {
                    "type": "string",
                    "description": "命令数据"
                  }
                },
                "required": ["kind", "data"],
                "additionalProperties": false
              }
            },
            "speech": {
              "type": "string",
              "description": "说出口的话"
            },
            "mood": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["calm", "tense"]
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": ["commands", "speech"],
          "additionalProperties": false
        }
      }
    },
    "fallbacks": "default"
  }
}
