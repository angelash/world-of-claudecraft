{
  "name": "openai_compat_tool_required",
  "method": "POST",
  "url": "https://api.example-llm.com/v1/chat/completions",
  "read": "json",
  "headers": {
    "content-type": "application/json"
  },
  "body": {
    "model": "example-chat",
    "messages": [
      {
        "role": "system",
        "content": "【规则】\n规则段：只按菜单行动。\n\n【人设】\n人设段：你是旅店老板。\n\n【私密】\n私密段：你记得昨天的客人。"
      },
      {
        "role": "user",
        "content": "上一轮：客人进门。"
      },
      {
        "role": "assistant",
        "content": "{\"commands\":[],\"speech\":\"欢迎。\"}"
      },
      {
        "role": "user",
        "content": "玩家原话：有空房吗？\n\n本轮：回答客人。\n\n【内核通知】\n内核通知：天色已晚。"
      }
    ],
    "max_tokens": 1000,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "submit",
          "description": "提交本轮的决定。",
          "parameters": {
            "type": "object",
            "properties": {
              "commands": {
                "type": "array",
                "description": "本次提出的命令",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["npc.say", "npc.move"],
                      "description": "命令种类"
                    },
                    "data": {
                      "type": "string",
                      "description": "命令数据"
                    }
                  },
                  "required": ["kind", "data"],
                  "additionalProperties": false
                }
              },
              "speech": {
                "type": "string",
                "description": "说出口的话"
              },
              "mood": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["calm", "tense"]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "note": {
                "type": ["string", "null"]
              }
            },
            "required": ["commands", "speech", "mood", "note"],
            "additionalProperties": false
          }
        }
      }
    ],
    "tool_choice": "required"
  }
}
