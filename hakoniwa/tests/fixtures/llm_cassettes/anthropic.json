{
  "provider": "anthropic",
  "note": "Answers in the shapes of the Anthropic Messages API (2026-11), written from the public API reference; the user re-records them with a real key per docs/50_tech/llm_providers.md 16.1. No credentials, request ids are fake.",
  "samples": [
    {
      "name": "json_schema answer with a thinking block and cache usage",
      "profile": "opus",
      "status": 200,
      "headers": {
        "request-id": "req_fixture_0001",
        "content-type": "application/json"
      },
      "body": {
        "id": "msg_fixture_0001",
        "type": "message",
        "role": "assistant",
        "model": "claude-opus-5-5",
        "content": [
          {
            "type": "thinking",
            "thinking": "",
            "signature": "c2lnLWZpeHR1cmUtMQ=="
          },
          {
            "type": "text",
            "text": "{\"commands\":[{\"kind\":\"npc.say\",\"data\":\"{}\"}],"
          },
          {
            "type": "text",
            "text": "\"speech\":\"客人，请坐。\"}"
          }
        ],
        "stop_reason": "end_turn",
        "stop_sequence": null,
        "usage": {
          "input_tokens": 812,
          "output_tokens": 96,
          "cache_read_input_tokens": 12000,
          "cache_creation_input_tokens": 1500,
          "cache_creation": {
            "ephemeral_5m_input_tokens": 500,
            "ephemeral_1h_input_tokens": 1000
          }
        }
      },
      "expect": {
        "text": "{\"commands\":[{\"kind\":\"npc.say\",\"data\":\"{}\"}],\"speech\":\"客人，请坐。\"}",
        "json": {
          "commands": [
            {
              "kind": "npc.say",
              "data": "{}"
            }
          ],
          "speech": "客人，请坐。"
        },
        "stopReason": "end",
        "rawStopReason": "end_turn",
        "usage": {
          "inputTokens": 812,
          "outputTokens": 96,
          "cacheReadInputTokens": 12000,
          "cacheCreationInputTokens": 1500,
          "cacheCreation1hInputTokens": 1000
        },
        "servedModel": "claude-opus-5-5",
        "fallbackUsed": false,
        "providerRequestId": "req_fixture_0001",
        "channel": "json_schema",
        "opaqueBlocks": 1
      }
