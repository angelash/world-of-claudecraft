        "eval_count": 48,
        "eval_duration": 1200000000
      },
      "expect": {
        "text": "{\"commands\":[],\"speech\":\"嗯\"}",
        "json": {
          "commands": [],
          "speech": "嗯"
        },
        "stopReason": "end",
        "usage": {
          "inputTokens": 812,
          "outputTokens": 48,
          "cacheReadInputTokens": 0,
          "cacheCreationInputTokens": 0
